APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-unique-development-password
POSTGRES_TEST_PASSWORD=replace-with-a-unique-test-password
DATABASE_URL=postgresql+psycopg://process:replace-with-a-unique-development-password@db:5432/process_control
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
TEST_JWT_SECRET=replace-with-a-different-test-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
INTERNAL_NETWORKS=127.0.0.1/32,::1/128
VITE_API_URL=http://localhost:8000/api/v1
